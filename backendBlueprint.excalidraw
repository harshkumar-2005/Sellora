    {
      "id": "2KqFOzw8O85U13gcwj7b9",
      "type": "text",
      "x": 3111.1666235923794,
      "y": -149.76043796539307,
      "width": 642.0000610351556,
      "height": 306.68792724609347,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b2p",
      "roundness": null,
      "seed": 1518149826,
      "version": 126,
      "versionNonce": 1837564098,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1772787603494,
      "link": null,
      "locked": false,
      "text": "| Module           | Description                |\n| ---------------- | -------------------------- |\n| Users            | View, ban, delete users    |\n| Products         | Add, edit, delete products |\n| Orders           | Manage orders and status   |\n| Categories       | Organize products          |\n| Content          | Blog posts, banners, pages |\n| Cart / Analytics | Monitor cart activity      |\n",
      "fontSize": 27.261149088541647,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "| Module           | Description                |\n| ---------------- | -------------------------- |\n| Users            | View, ban, delete users    |\n| Products         | Add, edit, delete products |\n| Orders           | Manage orders and status   |\n| Categories       | Organize products          |\n| Content          | Blog posts, banners, pages |\n| Cart / Analytics | Monitor cart activity      |\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "hrWb3M40Q7XWwOnTUpZhm",
      "type": "text",
      "x": 3161.1667761802696,
      "y": 261.7395009994507,
      "width": 847.5826546408913,
      "height": 315.40626525878906,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b2q",
      "roundness": null,
      "seed": 1556582338,
      "version": 45,
      "versionNonce": 1790120962,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1772787634060,
      "link": null,
      "locked": false,
      "text": "For an e-commerce project (like your sellora DB) the CMS typically manages:\n\nproducts\n\ncategories\n\nusers\n\norders\n\ninventory",
      "fontSize": 22.938637473366466,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "For an e-commerce project (like your sellora DB) the CMS typically manages:\n\nproducts\n\ncategories\n\nusers\n\norders\n\ninventory",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "aer6qulPW37rHqesWziMz",
      "type": "text",
      "x": 3182.1666846275352,
      "y": 734.2395296096809,
      "width": 567.9999999999999,
      "height": 259.22920892494926,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b2r",
      "roundness": null,
      "seed": 1787242014,
      "version": 40,
      "versionNonce": 2032583326,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1772787655906,
      "link": null,
      "locked": false,
      "text": "Flow\n\nAdmin logs in\n\nAdmin performs actions (add product, delete user)\n\nAPI processes request\n\nDatabase updates",
      "fontSize": 23.042596348884373,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Flow\n\nAdmin logs in\n\nAdmin performs actions (add product, delete user)\n\nAPI processes request\n\nDatabase updates",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "TBLcfLqKt1zVY1XPr-Bn2",
      "type": "text",
      "x": 3213.166669368746,
      "y": 1111.239575386048,
      "width": 394.99987792968744,
      "height": 206.44592923154394,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b2s",
      "roundness": null,
      "seed": 1723433886,
      "version": 59,
      "versionNonce": 975941186,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1772787685511,
      "link": null,
      "locked": false,
      "text": "Example API:\n\nPOST   /admin/products\nGET    /admin/products\nPUT    /admin/products/:id\nDELETE /admin/products/:id",
      "fontSize": 27.526123897539193,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Example API:\n\nPOST   /admin/products\nGET    /admin/products\nPUT    /admin/products/:id\nDELETE /admin/products/:id",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "dABAmeJI8b5n_ovBjQmeI",
      "type": "text",
      "x": 4183.6667528152475,
      "y": -131.0375280380249,
      "width": 242,
      "height": 200,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
