      "updated": 1772096901577,
      "link": null,
      "locked": false,
      "text": "User Uploads Video\n        ↓\nUpload Service (API)\n        ↓\nObject Storage (Raw Video)\n        ↓\nMessage Queue\n        ↓\nTranscoder Workers (FFmpeg)\n        ↓\nGenerate Multiple Resolutions (240p, 480p, 720p, 1080p)\n        ↓\nCreate HLS/DASH Segments\n        ↓\nStore Segments + Manifest\n        ↓\nCDN->Adaptive Streaming Player (Client)\n",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "User Uploads Video\n        ↓\nUpload Service (API)\n        ↓\nObject Storage (Raw Video)\n        ↓\nMessage Queue\n        ↓\nTranscoder Workers (FFmpeg)\n        ↓\nGenerate Multiple Resolutions (240p, 480p, 720p, 1080p)\n        ↓\nCreate HLS/DASH Segments\n        ↓\nStore Segments + Manifest\n        ↓\nCDN->Adaptive Streaming Player (Client)\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
